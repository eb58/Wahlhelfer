{
  "name": "wahlassistent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan-gestuetzte Auszaehlung von Papierstimmzetteln",
  "scripts": {
    "dev": "npm run build && vite preview --host localhost --port 5173 --strictPort",
    "dev:lan": "npm run build && vite preview --mode lan --host 0.0.0.0 --port 5173 --strictPort",
    "dev:source": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --test --test-reporter=./test/tools/specReporter.mjs \"test/**/*.test.js\"",
    "test:e2e": "playwright test -c test/e2e",
    "test:php": "node test/tools/ensure-phpunit.mjs && node test/tools/ensure-test-db.mjs && php test/tools/phpunit.phar --configuration test/phpunit.xml",
    "test:php:db:up": "docker compose -f test/docker-compose.test.yml up -d --wait",
    "test:php:db:down": "docker compose -f test/docker-compose.test.yml down -v",
    "deploy": "powershell -ExecutionPolicy Bypass -File server/deploy.ps1",
    "pruefe": "python scripts/pruefeKalibrierung.py"
  },
  "dependencies": {
    "ag-grid-community": "^35.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "vite": "^8.0.16"
  }
}
